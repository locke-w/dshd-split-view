{
  "name": "dshd-split-view",
  "version": "1.0.0",
  "description": "Antigravity 2.0-inspired native multi-session split view plugin for DeepSeek Harness Desktop (supporting macOS and Windows)",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "build": "node build.js"
  },
  "author": "locke-w",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/locke-w/dshd-split-view.git"
  },
  "bugs": {
    "url": "https://github.com/locke-w/dshd-split-view/issues"
  },
  "homepage": "https://github.com/locke-w/dshd-split-view#readme",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "desktop",
    "antigravity",
    "split-view",
    "multi-session",
    "electron",
    "macos",
    "windows",
    "分屏"
  ],
  "engines": {
    "node": ">=18"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "desktop",
      "immediately": true
    }
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "@deepseek-ai/cordis": "^4.0.1"
  }
}
